@model ToDoListMVC.Models.TaskItem
@{ ViewData["Title"] = "Детали"; }

<h1>Детали задачи</h1>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Title)</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Description)</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.IsCompleted)</dt>
    <dd class="col-sm-9">@(Model.IsCompleted ? "Да" : "Нет")</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("g")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Изменить</a>
<a asp-action="Index" class="btn btn-secondary">Назад</a>